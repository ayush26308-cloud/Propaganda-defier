# Copy to .env and fill in. All keys are optional — the server falls back to
# DuckDuckGo HTML scraping when no paid search API key is provided.

PORT=4567

# Optional: Google Custom Search JSON API (100 free queries/day)
# https://developers.google.com/custom-search/v1/overview
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Optional: Brave Search API (2000 free queries/month)
# https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
